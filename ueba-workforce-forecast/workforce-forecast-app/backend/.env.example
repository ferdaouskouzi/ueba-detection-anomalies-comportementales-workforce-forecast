# Copie ce fichier en .env et adapte les valeurs. Ne commite jamais le .env.

# Clé de signature des JWT. À générer avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

ACCESS_TOKEN_EXPIRE_MINUTES=480
TOTP_STEP_TOKEN_EXPIRE_MINUTES=5

# SQLite en dev. Remplacer par une URL PostgreSQL en production.
DATABASE_URL=sqlite:///./workforce.db

# Origines autorisées pour le frontend (CORS)
CORS_ORIGINS=http://localhost:5173
